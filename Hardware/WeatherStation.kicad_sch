	)
	(text "i2c pull  up calculatiion: \nmax bus capacitance  for fast mode = 400 pF\nrise time assumed to be t_r = 1000 ns -> nxp spec\nassumed V_ol_max = 0.4 V\nminimum sink current I_ol=3mA according to NXP I2C spec\n\nbus cap estimated as :  2xPins + 4 cm trace length with width 0.3 mm\nassuming approximately 3 pF per 1 cm of trace\n\n-->  2*10 pF + 4*3 pF = 32 pF\n\nlets assume a bus capacitance of 100 pF to be conservative\n\nMaximum pull up value R_max = t_r /(0.8473 * 100 pF) = 11.8 kOhm\nMinimum pull up value R_min = ( Vdd - V_ol ) / I_ol = 966 Ohm"
		(exclude_from_sim no)
		(at 249.682 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9dd3d372-84c4-4e91-a4c3-a2061da04f5a")
	)
